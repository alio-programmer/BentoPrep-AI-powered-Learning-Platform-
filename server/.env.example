# Copy to .env and fill in real values. NEVER commit the real .env.

# Supabase project credentials (Settings → API in your Supabase dashboard)
SUPABASE_URL=
# Use the service_role key (secret) — NOT the anon/public key.
SUPABASE_SERVICE_KEY=
# JWT secret for verifying Supabase access tokens (Settings → API → JWT Secret)
JWT_SECRET=
# Port the API server listens on
PORT=4000
# Client origin for CORS (comma-separated for multiple)
CLIENT_ORIGIN=http://localhost:5173
