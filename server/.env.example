# Copy to .env and fill in real values. NEVER commit the real .env.

# Supabase project credentials (Settings → API in your Supabase dashboard)
SUPABASE_URL=
# Use the service_role key (secret) — NOT the anon/public key.
SUPABASE_SERVICE_KEY=
# JWT secret for verifying Supabase access tokens (Settings → API → JWT Secret)
JWT_SECRET=
# Master key used to encrypt API keys at rest (AES-256-GCM).
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# NEVER commit the real value; rotation requires re-encrypting stored keys (see migrateKeys.js).
CREDENTIALS_ENC_KEY=
# Port the API server listens on
PORT=4000
# Client origin for CORS (comma-separated for multiple)
CLIENT_ORIGIN=http://localhost:5173
# Web Search API Key (Tavily) for augmenting AI roadmap and task explanations
TAVILY_API_KEY=

